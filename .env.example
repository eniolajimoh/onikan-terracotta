# MySQL connection used by Prisma and the API. Create this database first.
DATABASE_URL="mysql://root:password@localhost:3306/onikan_terracotta"

# API server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-secret

# Production uploads use Cloudinary; local development can use server/uploads instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
